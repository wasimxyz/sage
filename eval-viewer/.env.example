# Copy to .env.local. Same store as make eval-upload.
# BLOB_READ_WRITE_TOKEN=
# Optional. Defaults to sage-evals.
# SAGE_EVAL_BLOB_PREFIX=sage-evals
# Optional. Reports stay private unless this is public.
# SAGE_EVAL_BLOB_ACCESS=private
# Optional. Local reports folder when no Blob token is set.
# SAGE_EVAL_REPORTS=../agent/evals/reports
