# Ollama native API (eve loads .env.local, then .env)
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_WINDOW=32768
# Optional. Used by make eval-upload.
# BLOB_READ_WRITE_TOKEN=
# Optional. make eval reads agent/.env, then agent/.env.local.
# A value already set in the shell keeps that value.
# SAGE_SUMMARY_MODELS=qwen3.5:9b,qwen3:14b
# SAGE_EMBED_MODELS=nomic-embed-text,nomic-embed-text:latest
# SAGE_CHAT_MODELS is the make eval sweep list.
# SAGE_CHAT_MODEL is the chat model for one run. Chat evals read this first.
# SAGE_CHAT_MODEL=qwen3.5:9b
# SAGE_CHAT_MODELS=llama3.2,qwen3.5:9b
# SAGE_JUDGE_MODEL=qwen3.5:9b
