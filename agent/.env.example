# Ollama native API for make dev (eve loads .env.local, then .env).
# make dev runs Sage's bundled copy of Ollama on 11436.
OLLAMA_BASE_URL=http://127.0.0.1:11436/api
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_WINDOW=32768
# Optional. Used by make eval-upload.
# BLOB_READ_WRITE_TOKEN=
# Only make eval reads the settings below, and make eval reads agent/.env,
# then agent/.env.local. A value already set in the shell keeps that value.
# make eval ignores OLLAMA_BASE_URL, OLLAMA_MODEL, and OLLAMA_CONTEXT_WINDOW.
# Credential for the cloud judge, through Vercel AI Gateway. Set one. Only the
# eve eval processes get it. Sage and Chat never see it.
# AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=
# Comma-separated lists that replace the models in the sweep file.
# SAGE_SUMMARY_MODELS=qwen3.5:9b,qwen3:14b
# SAGE_EMBED_MODELS=nomic-embed-text,nomic-embed-text:latest
# SAGE_CHAT_MODELS=llama3.2,qwen3.5:9b
