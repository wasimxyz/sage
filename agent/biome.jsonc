{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "vcs": {
    "root": ".."
  },
  "files": {
    "includes": ["!!.eve", "!!.output", "!!evals/.cache", "!!evals/reports"]
  },
  "linter": {
    "rules": {
      "style": {
        // TypeScript types every named group as string | undefined, so
        // match.groups.name needs more checks than match[1].
        "useNamedCaptureGroup": "off"
      }
    }
  },
  "overrides": [
    {
      // eve exposes a tool under its filename, so renaming a file renames the
      // tool the model sees.
      "includes": ["agent/tools/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
