{
  "name": "sage-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "build": "EVE_TELEMETRY_DISABLED=1 eve build --skip-sandbox-prewarm",
    "check": "ultracite check",
    "dev": "EVE_TELEMETRY_DISABLED=1 NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--import=\\\"$(pwd)/scripts/dev-auth-hook.ts\\\" --import=\\\"$(pwd)/agent/lib/workflow-guard-preload.ts\\\"\" eve dev --no-default-extensions",
    "eval": "EVE_TELEMETRY_DISABLED=1 eve eval --max-concurrency 1",
    "fix": "ultracite fix",
    "start": "EVE_TELEMETRY_DISABLED=1 eve start",
    "test:evals": "node --test --experimental-strip-types evals/lib/*.test.ts",
    "test:scripts": "node --test --experimental-strip-types scripts/*.test.ts",
    "test:world": "node --test --experimental-strip-types packages/world-encrypted-local/index.test.ts",
    "typecheck": "tsc"
  },
  "overrides": {
    "@ai-sdk/provider-utils": {
      "undici": "^7.30.1"
    },
    "@workflow/world-local": {
      "undici": "^7.30.1"
    },
    "eve": {
      "undici": "^8.12.2"
    },
    "zod": "$zod"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "^5.0.44",
    "@sage/world-encrypted-local": "file:./packages/world-encrypted-local",
    "@workflow/world": "5.0.3",
    "@workflow/world-local": "5.1.0",
    "ai": "^7.0.143",
    "eve": "^0.80.1",
    "ollama-ai-provider-v2": "^4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "24.x",
    "@vercel/blob": "^2.8.0",
    "typescript": "7.0.2",
    "ultracite": "^7.12.2"
  },
  "engines": {
    "node": "24.x"
  }
}
